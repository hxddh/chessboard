.{
    .id = "dev.hxddh.chessboard",
    .name = "chessboard",
    .display_name = "国际象棋",
    .description = "Chess for macOS & Windows — Native SDK WebView + Canvas, GPLv3.",
    .version = "20.0.0",
    .icons = .{ "assets/icon.icns", "assets/icon.ico", "assets/icon.png" },
    .platforms = .{ "macos", "windows" },
    .permissions = .{},
    .capabilities = .{ "webview", "sqlite" },
    .frontend = .{
        .dist = "frontend/dist",
        .entry = "index.html",
        .spa_fallback = false,
    },
    // 7.0：.pgn 的文档类型声明搬进 manifest。
    //
    // scripts/add-pgn-doctype.sh 的文件头写着它为什么曾经是「打包后改 plist」：
    // 「0.8.1 的 CLI 是否接受在 app.zon 里声明文档类型，这个仓库看不到任何文档；
    // 一个未知的键既可能被忽略，也可能让 native validate 直接失败。」0.10.1 随包
    // 附了 schemas/app.schema.json，这个键在里面（name / role / extensions /
    // mime_types / icon），所以答案不再靠猜。
    //
    // LSHandlerRank 的用意保持不变：alternate —— 绝不从用户已经装好的专业 PGN
    // 编辑器手里抢走默认打开权。
    //
    // 那个脚本暂时留着。本机装不了 zig，也跑不了 native package，所以「SDK 写出来
    // 的 plist 和脚本写的是不是一回事」只有真机能回答；脚本自称幂等（「SDK 若支持
    // 了，这里的 Delete 只是替换它写的东西」），所以两者并存是安全的。真机核对过
    // 之后再删脚本，这条记在 docs/manual-check.md 里。
    .file_associations = .{
        .{
            .name = "PGN 棋谱",
            // "viewer", not "alternate": the SDK's role vocabulary is
            // viewer / editor / shell / none (schemas/app.schema.json
            // $defs.associationRole), and anything else falls through to
            // Viewer silently. The *rank* — never take the default .pgn
            // handler away from a dedicated PGN editor — is LSHandlerRank,
            // which this key cannot express; scripts/add-pgn-doctype.sh
            // still writes it, and says so.
            .role = "viewer",
            .extensions = .{"pgn"},
            .mime_types = .{"application/x-chess-pgn"},
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{ "zero://app", "zero://inline", "http://127.0.0.1:5173" },
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "system",
    // 20.0 E3: the menu bar for 20.0's places (学 / 下 / 我, 设置) and what a
    // player does in a game. A command reaches the page as a "shortcut"
    // window event (main.zig → src/app/services/shell.js), which runs it on
    // the page that has it — or opens that page first (新对局 → 下, 导入 PGN
    // → 我). The labels here are Chinese; menus.zig has the English and
    // Japanese, and the page's language rebuilds the bar (chess.setMenuLanguage).
    // The keys are the in-page letters' (Z 悔棋, F 翻转) with ⌘ / Ctrl, so
    // they never fire while typing. On macOS mac_chrome.m moves 设置… into
    // the app menu, drops 退出 and 关于 (the app menu has both), and adds Edit
    // and Window; on Windows the shell answers 退出 and 关于 itself.
    .menus = .{
        .{
            .title = "对局",
            .items = .{
                .{ .label = "新对局", .command = "game.new", .key = "n", .modifiers = .{"primary"} },
                .{ .label = "悔棋", .command = "game.undo", .key = "z", .modifiers = .{"primary"} },
                .{ .label = "翻转棋盘", .command = "game.flip", .key = "f", .modifiers = .{"primary"} },
                // ⌘H is the system's "Hide <app>" (1.18): the hint takes ⌘⇧H
                .{ .label = "提示", .command = "game.hint", .key = "h", .modifiers = .{ "primary", "shift" } },
                .{ .separator = true },
                .{ .label = "导入 PGN…", .command = "file.import", .key = "o", .modifiers = .{"primary"} },
                .{ .separator = true },
                .{ .label = "退出", .command = "app.quit", .key = "q", .modifiers = .{"primary"} },
            },
        },
        .{
            .title = "前往",
            .items = .{
                .{ .label = "学", .command = "go.learn", .key = "1", .modifiers = .{"primary"} },
                .{ .label = "下", .command = "go.play", .key = "2", .modifiers = .{"primary"} },
                .{ .label = "我", .command = "go.me", .key = "3", .modifiers = .{"primary"} },
                .{ .separator = true },
                .{ .label = "上一手", .command = "view.prev", .key = "[", .modifiers = .{"primary"} },
                .{ .label = "下一手", .command = "view.next", .key = "]", .modifiers = .{"primary"} },
                .{ .separator = true },
                .{ .label = "设置…", .command = "go.settings", .key = ",", .modifiers = .{"primary"} },
            },
        },
        .{
            .title = "帮助",
            .items = .{
                .{ .label = "关于国际象棋", .command = "app.about" },
            },
        },
    },
    // Escape, as a declared shortcut. The AppKit host installs a key-down
    // monitor for declared shortcuts and lets everything else through to the
    // WebView — and on the shipped 5.2.0 Escape never reached the page: a
    // pinned engine line stayed pinned, a dialog stayed open, while → and P
    // worked (docs/manual-check.md, 2026-09-06). Declaring it turns the key
    // into a shortcut event the page already subscribes to (host.js →
    // runNativeCommand), which is a path that demonstrably works. The in-page
    // handler stays for the browser. `.id` is the command name the page runs.
    .shortcuts = .{
        .{ .id = "view.escape", .key = "escape" },
    },
    .windows = .{
        .{
            .label = "main",
            .title = "国际象棋",
            .width = 1200,
            .height = 900,
            .min_width = 520,
            .min_height = 520,
            .restore_state = true,
        },
    },
}
